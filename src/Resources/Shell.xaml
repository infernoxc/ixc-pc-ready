<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="232"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
    <DockPanel Margin="14,20,14,16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
        <Border Width="36" Height="36" CornerRadius="10">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#181C40" Offset="0"/><GradientStop Color="#5C36C4" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Path Fill="#38C8D2FF" Data="M 5,15 A 5,5 0 0 1 10,10 A 7,7 0 0 1 24,10 A 5,5 0 0 1 31,16 L 31,17 L 5,17 Z"/>
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 21,3 L 9,20 L 16,20 L 14,33 L 27,14 L 20,14 Z" Stretch="Uniform" Width="17" Height="26">
              <Path.Fill>
                <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                  <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#FFD640" Offset="1"/>
                </LinearGradientBrush>
              </Path.Fill>
              <Path.Effect><DropShadowEffect Color="#FFE45C" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
            </Path>
          </Grid>
        </Border>
        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="InFerNoxC" FontSize="11" FontWeight="SemiBold" Foreground="#FFD640"/>
          <TextBlock Text="IXC PC Ready" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,-1,0,0"/>
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,8,12"/>
        <TextBlock x:Name="FootVer" Style="{StaticResource Muted}" FontSize="11.5"/>
        <TextBlock x:Name="FootMaker" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
      </StackPanel>

      <StackPanel>
        <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Dashboard" GroupName="nav" IsChecked="True"/>
        <RadioButton x:Name="NavProc" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="Processes" GroupName="nav"/>
        <RadioButton x:Name="NavGame" Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="Game Mode" GroupName="nav"/>
        <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Tag="&#xE74D;" Content="Clean &amp; Optimize" GroupName="nav"/>
        <RadioButton x:Name="NavStart" Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="Startup &amp; Services" GroupName="nav"/>
        <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="Installed Apps" GroupName="nav"/>
        <RadioButton x:Name="NavCrash" Style="{StaticResource Nav}" Tag="&#xE7BA;" Content="Crash Report" GroupName="nav"/>
        <RadioButton x:Name="NavTune" Style="{StaticResource Nav}" Tag="&#xE9E9;" Content="Smart Tune" GroupName="nav"/>
        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings &amp; About" GroupName="nav"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <ContentControl x:Name="PageHost" Grid.Column="1" IsTabStop="False" Focusable="False"/>
</Grid>
