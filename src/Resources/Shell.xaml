<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="SideCol" Width="224"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <Border x:Name="SideBox" ClipToBounds="True" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
    <DockPanel x:Name="SideDock" Margin="12,18,12,14">
      <StackPanel x:Name="BrandBox" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
        <Image x:Name="LogoImg" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="BrandText" Text="IXC PC Ready" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
      </StackPanel>

      <StackPanel x:Name="FootBox" DockPanel.Dock="Bottom" Margin="8,0,0,0">
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,8,10"/>
        <TextBlock x:Name="FootMaker" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
          <TextBlock x:Name="FootVer" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
          <TextBlock Text="  |  " Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
          <TextBlock x:Name="FootUpd" Text="Check for update" FontSize="11.5" Foreground="{StaticResource AccentHiBrush}" Cursor="Hand" TextWrapping="NoWrap"/>
        </StackPanel>
      </StackPanel>

      <StackPanel>
        <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Dashboard" GroupName="nav" IsChecked="True"/>
        <RadioButton x:Name="NavProc" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="Processes" GroupName="nav"/>
        <RadioButton x:Name="NavGame" Style="{StaticResource Nav}" Tag="&#xE7FC;" Content="Game Mode" GroupName="nav"/>
        <RadioButton x:Name="NavProf" Style="{StaticResource Nav}" Tag="&#xE77B;" Content="App Profiles" GroupName="nav"/>
        <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Tag="&#xE74D;" Content="Clean &amp; Optimize" GroupName="nav"/>
        <RadioButton x:Name="NavDebloat" Style="{StaticResource Nav}" Tag="&#xE894;" Content="Debloat" GroupName="nav"/>
        <RadioButton x:Name="NavUpd" Style="{StaticResource Nav}" Tag="&#xE895;" Content="Updates" GroupName="nav"/>
        <RadioButton x:Name="NavStart" Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="Startup &amp; Services" GroupName="nav"/>
        <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="Installed Apps" GroupName="nav"/>
        <RadioButton x:Name="NavCrash" Style="{StaticResource Nav}" Tag="&#xE7BA;" Content="Crash Center" GroupName="nav"/>
        <RadioButton x:Name="NavTune" Style="{StaticResource Nav}" Tag="&#xE9E9;" Content="Smart Tune" GroupName="nav"/>
        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings &amp; About" GroupName="nav"/>
      </StackPanel>
    </DockPanel>
  </Border>

  <ContentControl x:Name="PageHost" Grid.Column="1" IsTabStop="False" Focusable="False"/>
</Grid>
