<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="32,28,32,22">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="Processes"/>
    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
               Text="Live CPU, GPU and memory use per app. Apps with several processes are grouped. Tune a game's priority or graphics preference below."/>
  </StackPanel>

  <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
      <TextBlock Text="Sort by" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <RadioButton x:Name="SortCpu" Style="{StaticResource Seg}" Content="CPU" GroupName="sort" IsChecked="True"/>
      <RadioButton x:Name="SortGpu" Style="{StaticResource Seg}" Content="GPU" GroupName="sort"/>
      <RadioButton x:Name="SortRam" Style="{StaticResource Seg}" Content="Memory" GroupName="sort"/>
      <RadioButton x:Name="SortVram" Style="{StaticResource Seg}" Content="VRAM" GroupName="sort"/>
    </StackPanel>
    <TextBox x:Name="Search" DockPanel.Dock="Right" Style="{StaticResource Box}" Width="170" FontSize="12.5"/>
    <TextBlock Text="Search" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,26,0">
      <RadioButton x:Name="ShowAll" Style="{StaticResource Seg}" Content="All apps" GroupName="show" IsChecked="True"/>
      <RadioButton x:Name="ShowGames" Style="{StaticResource Seg}" Content="Games only" GroupName="show"/>
    </StackPanel>
  </DockPanel>

  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,4,6,6">
    <DataGrid x:Name="Grid" Background="Transparent">
      <DataGrid.Columns>
        <DataGridTextColumn Header="APP" Binding="{Binding Display}" Width="*"/>
        <DataGridTextColumn Header="" Binding="{Binding Kind}" Width="64">
          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="90"/>
        <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" Width="90"/>
        <DataGridTextColumn Header="MEMORY" Binding="{Binding RamText}" Width="100"/>
        <DataGridTextColumn Header="VRAM" Binding="{Binding VramText}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
  </Border>

  <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="BtnHigh" Style="{StaticResource GhostBtn}" Content="High priority" Margin="0,0,8,0"/>
        <Button x:Name="BtnNormal" Style="{StaticResource GhostBtn}" Content="Normal" Margin="0,0,8,0"/>
        <Button x:Name="BtnLow" Style="{StaticResource GhostBtn}" Content="Below normal" Margin="0,0,18,0"/>
        <Button x:Name="BtnGpuHigh" Style="{StaticResource GhostBtn}" Content="GPU: High perf" Margin="0,0,8,0"/>
        <Button x:Name="BtnGpuAuto" Style="{StaticResource GhostBtn}" Content="GPU: Auto"/>
      </StackPanel>
      <TextBlock x:Name="SelInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Select an app to tune it."/>
    </DockPanel>
  </Border>
</Grid>
