<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Focusable="False">
  <StackPanel x:Name="PageBody" Margin="32,28,32,28">
    <TextBlock Style="{StaticResource H1}" Text="Dashboard"/>
    <TextBlock x:Name="Sub" Style="{StaticResource Muted}" Margin="0,4,0,20"/>

    <UniformGrid x:Name="RowGauges" Columns="4" Margin="0,0,0,12">
      <Border x:Name="G1" Style="{StaticResource Card}" Height="200" Margin="0,0,12,0" Padding="4"/>
      <Border x:Name="G2" Style="{StaticResource Card}" Height="200" Margin="0,0,12,0" Padding="4"/>
      <Border x:Name="G3" Style="{StaticResource Card}" Height="200" Margin="0,0,12,0" Padding="4"/>
      <Border x:Name="G4" Style="{StaticResource Card}" Height="200" Padding="4"/>
    </UniformGrid>
    <TextBlock x:Name="SensorNote" Style="{StaticResource Muted}" Margin="4,0,0,14" Visibility="Collapsed"/>

    <UniformGrid x:Name="RowStats" Columns="4" Margin="0,0,0,14">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Memory" Style="{StaticResource Muted}"/>
          <TextBlock x:Name="RamVal" Style="{StaticResource Big}" Text="-" Margin="0,4,0,8"/>
          <ProgressBar x:Name="RamBar" Style="{StaticResource Thin}"/>
          <TextBlock x:Name="RamSub" Style="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Video memory" Style="{StaticResource Muted}"/>
          <TextBlock x:Name="VramVal" Style="{StaticResource Big}" Text="-" Margin="0,4,0,8"/>
          <ProgressBar x:Name="VramBar" Style="{StaticResource Thin}"/>
          <TextBlock x:Name="VramSub" Style="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Disk activity" Style="{StaticResource Muted}"/>
          <TextBlock x:Name="DiskVal" Style="{StaticResource Big}" Text="-" Margin="0,4,0,8"/>
          <ProgressBar x:Name="DiskBar" Style="{StaticResource Thin}"/>
          <TextBlock x:Name="DiskSub" Style="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Power plan" Style="{StaticResource Muted}"/>
          <TextBlock x:Name="PlanVal" Style="{StaticResource Big}" Text="-" FontSize="20" Margin="0,10,0,10" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="PlanSub" Style="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid x:Name="RowInfo" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Your hardware" Margin="0,0,0,12"/>
          <StackPanel x:Name="HwList"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="Health checks" Margin="0,0,0,12"/>
          <StackPanel x:Name="FindList"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="Heaviest right now" Margin="0,0,0,12"/>
        <UniformGrid x:Name="RowTop" Columns="3">
          <StackPanel Margin="0,0,18,0"><TextBlock Text="CPU" Style="{StaticResource Muted}" Margin="0,0,0,6"/><StackPanel x:Name="TopCpu"/></StackPanel>
          <StackPanel Margin="0,0,18,0"><TextBlock Text="GPU" Style="{StaticResource Muted}" Margin="0,0,0,6"/><StackPanel x:Name="TopGpu"/></StackPanel>
          <StackPanel><TextBlock Text="Memory" Style="{StaticResource Muted}" Margin="0,0,0,6"/><StackPanel x:Name="TopRam"/></StackPanel>
        </UniformGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</ScrollViewer>
